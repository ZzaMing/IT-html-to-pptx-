{
  "name": "it-volunteer-presentation",
  "version": "1.0.0",
  "description": "Sahmyook University IT Volunteer Presentation",
  "scripts": {
    "build": "node build.js",
    "watch": "node watch.js",
    "pptx": "npx.cmd @marp-team/marp-cli presentation.md -o 삼육대학교_다낭IT봉사단_교원대_웹프로그래밍_평가보고서_v04.pptx --pptx --html --allow-local-files --no-stdin --browser-path \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "pdf": "npx.cmd @marp-team/marp-cli presentation.md -o 삼육대학교_다낭IT봉사단_교원대_웹프로그래밍_평가보고서_v04.pdf --pdf --html --allow-local-files --no-stdin --browser-path \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "build:all": "node build.js && npm run pptx && npm run pdf"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1"
  }
}
